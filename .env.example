# Copy to backend/.env and fill in. NEVER commit the real .env file.

NODE_ENV=development
PORT=4000

# MongoDB connection string (e.g. a free MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/boosie_network?retryWrites=true&w=majority

# Long random string (>= 32 chars) used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# Where the React site runs (comma-separated for several). Used for CORS and the Origin check.
CLIENT_ORIGIN=http://localhost:5173
# Set true when the site is served over HTTPS (defaults to true in production).
# COOKIE_SECURE=true

# Cloudinary (https://cloudinary.com/console). Without these, uploads return a clear "not configured" error.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First administrator — used only by `npm run bootstrap-admin`. Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Optional: enables POST /api/auth/bootstrap (works only while there are zero users). Leave empty to disable.
BOOTSTRAP_TOKEN=
